# ---------------------------------------------------------------------------
# Pipedrive — form submissions become Leads
#
# Simplebooks runs two Pipedrive accounts. Submissions are routed by the page
# they came from (see accountFor() in lib/pipedrive.ts):
#
#   /tax/*        -> the TAX account
#   everything else -> the BUSINESS REGISTRATION account
#
# Each token is a personal API token from that account:
#   Pipedrive > account name (top right) > Company settings
#            > Personal preferences > API
# or directly at https://app.pipedrive.com/settings/api
#
# A user has a DIFFERENT token for each company they belong to, so take each
# one while signed into that company.
#
# Leave a token blank and that account's forms return a clear "not connected"
# message instead of silently dropping the enquiry.
# ---------------------------------------------------------------------------
PIPEDRIVE_TOKEN_BUSINESS=
PIPEDRIVE_TOKEN_TAX=
