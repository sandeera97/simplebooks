# Build-time env for the vendored free-tools calculators.
# Only used by scripts/update-free-tools.sh when it has to build their app from
# source — normally we publish the export they ship, which already has this
# baked in.
#
# Their hooks/analytics.ts throws at import time when this is missing, which
# takes the page down at hydration rather than just disabling tracking.
#
# This is not a secret: it is a Facebook Pixel id, served to every visitor in
# the page source. The value was read back out of the bundle the tools team
# shipped. If it ever looks wrong, confirm it with them rather than guessing.
NEXT_PUBLIC_PIXEL_ID=1574565626176939
