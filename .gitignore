# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the free-tools build env: the pixel id in it is already public
# in the bundle we commit under public/tools, and without it a rebuild of
# their app produces pages that crash on load.
!.env.free-tools

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Vendored free-tools calculators (see external/free-tools/README-INTEGRATION.md).
# Their build artefacts are rebuilt by scripts/update-free-tools.sh; only the
# published export in public/tools is committed. Kept here rather than in their
# .gitignore so a new drop from the tools team cannot undo it.
/external/free-tools/node_modules/
/external/free-tools/out/
/external/free-tools/.next/
