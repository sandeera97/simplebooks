{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Blog posts shown at /srilanka/blog on the website."
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "title": { "type": "string", "required": true, "maxLength": 180 },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true,
      "maxLength": 300
    },
    "body": { "type": "richtext" },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Secretarial Service",
        "Payroll Management",
        "Business Registration",
        "Tax",
        "Other"
      ],
      "default": "Other",
      "required": true
    },
    "authorName": { "type": "string", "default": "Simplebooks" },
    "authorRole": { "type": "string" },
    "readTime": { "type": "string", "description": "e.g. \"6 min read\"" },
    "seoTitle": { "type": "string", "maxLength": 70 },
    "seoDescription": { "type": "text", "maxLength": 170 }
  }
}
